# Copy to .env and adjust. .env is git-ignored; never commit real keys.
# These values are read by the backend only and are never sent to the frontend.

# --- Storage ---
DATABASE_URL=sqlite:///./data/studypilot.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
MAX_PAGES=500

# --- AI provider: "mock" (offline, free, sample output), "ollama" (local model) or "anthropic" ---
# Deployments without a .env use mock automatically.
# To use a local model: install Ollama, run `ollama pull llama3.1:8b`, then set AI_PROVIDER=ollama
# and AI_TIMEOUT_SECONDS=300 (local models can take minutes per request).
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=60

# --- Ollama (only used when AI_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Context window in tokens. Bigger = more of the PDF per request, but more RAM and slower.
OLLAMA_NUM_CTX=8192
AI_MAX_ATTEMPTS=3
AI_RETRY_BACKOFF_SECONDS=1.0
AI_MAX_TOKENS=4096
AI_MAX_CONTEXT_CHARS=60000

# --- Mock provider behaviour (only when AI_PROVIDER=mock) ---
# ok | provider_error | auth_error | invalid_json | schema_invalid | bad_page | flaky | flaky_invalid
MOCK_MODE=ok
MOCK_FAIL_TIMES=2

# --- Retrieval / chat ---
RETRIEVAL_TOP_K=5
CHAT_HISTORY_MESSAGES=6

# --- HTTP: comma-separated origins allowed to call the API (the future frontend dev server) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
