# ───────────────────────── Secrets ─────────────────────────
# API keys live only in .env files; the template is safe to commit.
.env
.env.*
!.env.example
*.pem
*.key

# ───────────────────────── Python (backend) ─────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local data: SQLite database and uploaded PDFs
backend/data/
*.db
*.sqlite
*.sqlite3

# ───────────────────────── Node (frontend) ─────────────────────────
node_modules/
dist/
*.tsbuildinfo
.vite/
.eslintcache
coverage/

# Playwright / e2e output (fixtures in frontend/e2e/fixtures ARE committed)
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/
frontend/e2e/.tmp/

# Performance measurement output (see frontend/PERFORMANCE.md)
frontend/perf-results.json
frontend/perf-navigation-failure.png

# ───────────────────────── Logs ─────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ───────────────────────── OS / editors ─────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
